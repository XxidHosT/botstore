# Salin ke .env di VPS (JANGAN di-commit). Buat token: openssl rand -hex 32
ADMIN_TOKEN=ganti-dengan-token-acak-panjang
DOMAIN=chat.contoh.com
ALLOWED_ORIGINS=https://contoh.com
TRUST_PROXY=1
IP_RATE_PER_MIN=60

# Webhook ke panel admin (opsional; kosong = mati). Bot POST ke URL ini saat handoff dan saat pelanggan mengetik selagi admin memegang chat.
HANDOFF_WEBHOOK_URL=https://panel.tokomu.com/api/bot-webhook
HANDOFF_WEBHOOK_SECRET=ganti-dengan-rahasia-acak

# Notifikasi Discord saat handoff (opsional). Buat di Discord: Channel > Edit > Integrations > Webhooks. URL ini RAHASIA.
DISCORD_WEBHOOK_URL=
PANEL_LINK_TEMPLATE=https://panel.tokomu.com/chat/{id}
DISCORD_MENTION_ROLE_ID=
