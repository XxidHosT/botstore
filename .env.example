# Salin ke .env di server (JANGAN di-commit). Buat token: openssl rand -hex 32

# Admin API bot (dasbor review, daftar handoff). Kosong = endpoint admin mati. Bot hanya listen di 127.0.0.1.
ADMIN_TOKEN=ganti-dengan-token-acak-panjang

# Katalog dibaca langsung dari website jualgame (harga sama dengan halaman /games).
# CATALOG_TOKEN harus sama persis dengan BOT_API_TOKEN di .env website.
CATALOG_URL=http://127.0.0.1:3000
CATALOG_TOKEN=ganti-dengan-token-yang-sama-dengan-BOT_API_TOKEN
SITE_URL=https://jualgame.id

# Website yang memanggil bot (server-ke-server) meneruskan IP pengunjung lewat X-Forwarded-For.
TRUST_PROXY=1
IP_RATE_PER_MIN=60

# Notifikasi Discord saat handoff (opsional). Buat di Discord: Channel > Edit > Integrations > Webhooks. URL ini RAHASIA.
DISCORD_WEBHOOK_URL=
PANEL_LINK_TEMPLATE=https://jualgame.id/admin/chat
DISCORD_MENTION_ROLE_ID=

# Webhook ke panel admin lain (opsional; tidak perlu bila memakai inbox admin website).
# HANDOFF_WEBHOOK_URL=
# HANDOFF_WEBHOOK_SECRET=
